# Yapay SDK Project Dependency Versions
# This file ensures version consistency between yapay and yapay-sdk projects
# Generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)

# Go toolchain version (must match exactly with yapay project)
GO_VERSION=go1.24.7
GO_TOOLCHAIN=go1.24.7

# Core project versions
YAPAY_SDK_VERSION=v1.0.10
YAPAY_PROJECT_VERSION=v1.0.0

# Build metadata
BUILD_DATE=2024-12-19T10:00:00Z
BUILD_ENV=modules-only

# Key dependency versions (for verification)
LOGURUS_VERSION=v1.9.3
TESTIFY_VERSION=v1.11.1

# Module cache configuration
GOMODCACHE_PATH=/gomodcache
GOCACHE_PATH=/tmp/gocache

# Build flags for modules-only approach
GO_MOD_FLAGS="-mod=mod"
GO_BUILD_FLAGS="-buildvcs=false -ldflags=\"-w -s\""

# Compatibility requirements
MIN_GO_VERSION="1.24"
MAX_GO_VERSION="1.24"
REQUIRED_GO_MOD_VERSION="2"

# Verification commands
GO_VERSION_CHECK="go version | cut -d' ' -f3"
YAPAY_SDK_CHECK="grep \"module github.com/metalmon/yapay-sdk\" go.mod | cut -d' ' -f3"
